{
  "name": "@mnemo/importers",
  "version": "0.1.0",
  "private": true,
  "description": "Format detection, tolerant cleanup, parsers, validation, error reports and exports.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "schema": "tsx scripts/generate-schema.ts",
    "examples": "tsx scripts/generate-examples.ts"
  },
  "dependencies": {
    "@mnemo/core": "workspace:*",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.3"
  }
}
