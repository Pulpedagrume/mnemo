# Mnemo server configuration. Copy to .env and adjust. Never commit the real .env.

# Address and port to listen on. 127.0.0.1 = this machine only (single-user mode possible);
# 0.0.0.0 = every interface (accounts required, SESSION_SECRET mandatory).
HOST=127.0.0.1
PORT=8787

# Where accounts.sqlite and users/<id>.sqlite live (default ~/.mnemo; /data in Docker).
# Back this directory up: it is all your data.
DATA_DIR=

# Public URL of the server, e.g. https://mnemo.example.org. When it starts with https://,
# cookies get the Secure flag and HSTS is sent.
BASE_URL=

# Who can create an account:
#   closed (default) - nobody, except the first administrator account, created with the
#                      one-time invite printed in the logs at the first start;
#   invite           - anyone holding an invite created by an administrator (POST /api/v1/invites);
#   open             - anyone (only on a private network!).
REGISTRATION_MODE=closed

# Secret key (>= 32 random characters) used to hash session ids, API tokens and invites.
# Required unless HOST is a loopback address. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everybody out and invalidates every API token.
SESSION_SECRET=

# Maximum size of an import upload, in MB.
MAX_UPLOAD_MB=20

# Set when behind a reverse proxy so client IPs (rate limits, audit log) are right:
# "true" (trust every proxy), a hop count such as 1, or comma-separated proxy addresses.
TRUST_PROXY=

# Extra origins allowed to call the API from a browser (comma-separated). Empty = same origin only.
CORS_ORIGINS=

# Directory of the built web app (apps/web/dist). Auto-detected when empty.
WEB_DIST=

# Single-user mode without login. Only accepted on a loopback HOST.
NO_AUTH=false

# Log level: fatal, error, warn, info, debug.
LOG_LEVEL=info

# Outgoing mail (not used yet: reserved for password reset and invites by email).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
