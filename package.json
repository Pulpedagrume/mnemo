{
  "name": "mnemo",
  "version": "0.0.0",
  "private": true,
  "description": "Configurable spaced-repetition app with AI-friendly import. Local-first, self-hostable.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --testTimeout=20000",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --testTimeout=20000",
    "e2e": "pnpm --filter @mnemo/web e2e",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @mnemo/web dev",
    "check:licenses": "node scripts/check-licenses.mjs",
    "knip": "knip",
    "rename-app": "node scripts/rename-app.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "screenshots": "SCREENSHOTS=1 pnpm --filter @mnemo/web exec playwright test --grep @screenshots --project=chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
